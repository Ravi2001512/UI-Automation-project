<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="All Test Suite">

    <test verbose="2"
          preserve-order="true"
          name="UI Automation Tests">

        <classes>

            <class name="com.ucsc.tutionplatform.tests.userdetails.CreateUserTest">
                <methods>
                    <include name="verifyThatUserCanBeCreatedByProvidingMandatoryFieldsOnly"/>
                </methods>
            </class>

            <class name="com.ucsc.tutionplatform.tests.userdetails.EditUserTest">
                <methods>
                    <include name="verifyUserLevelCanBeChangedBetweenAdminAndModerate"/>
                </methods>
            </class>

        </classes>

    </test>

</suite>