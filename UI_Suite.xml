<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="UI Automation Regression Suite"
       verbose="2"
       preserve-order="true">

    <test name="Login Module">
        <classes>
            <class name="com.ucsc.tutionplatform.tests.login.LoginPageTest"/>
        </classes>
    </test>

    <test name="User Details Module">
        <classes>
            <class name="com.ucsc.tutionplatform.tests.userdetails.CreateUserTest"/>
            <class name="com.ucsc.tutionplatform.tests.userdetails.CreateUserNewTest"/>
            <class name="com.ucsc.tutionplatform.tests.userdetails.SearchUserTest"/>
            <class name="com.ucsc.tutionplatform.tests.userdetails.EditUserTest"/>
        </classes>
    </test>

    <test name="Class Examination Module">
        <classes>
            <class name="com.ucsc.tutionplatform.tests.classexaminations.CreateExaminationTest"/>
            <class name="com.ucsc.tutionplatform.tests.classexaminations.SearchExamDetailsTest"/>
            <class name="com.ucsc.tutionplatform.tests.classexaminations.ExamSelectionTest"/>
            <class name="com.ucsc.tutionplatform.tests.classexaminations.CalculateAverageTest"/>
            <class name="com.ucsc.tutionplatform.tests.classexaminations.SingleUploadTest"/>
            <class name="com.ucsc.tutionplatform.tests.classexaminations.BulkUploadTest"/>
        </classes>
    </test>

</suite>